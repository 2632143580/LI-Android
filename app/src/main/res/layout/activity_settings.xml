<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部应用栏 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ========== 1. 主动推送总开关 ========== -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="主动推送（总开关）"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />
                <Switch
                    android:id="@+id/swEnabled"
                    android:contentDescription="主动推送总开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView
                android:text="关闭后 App 不再后台主动找你；前台聊天照常。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ========== 2. 推送用 LLM ========== -->
            <TextView
                android:text="推送用 LLM（后台 AI 说话的脑子）"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:text="App 在你不打开 LI 时，靠它生成主动推送的话。和你在 LI 里聊天用的 LLM 默认是两套——因为后台时网页没开。下面可勾选「填一次，两边通用」。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:text="API Key" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etKey" android:hint="sk-... 或你的 LLM 密钥" android:inputType="textPassword" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:text="接口地址" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etBase" android:hint="如 https://api.openai.com/v1" android:inputType="textUri" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:text="模型名称" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etModel" android:hint="如 gpt-4o-mini / deepseek-chat" android:inputType="text" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/cbSyncWeb"
                android:text="填一次，两边通用：把上面的 Key 也用作 LI 前台聊天"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ========== 3. 推送行为 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="推送行为" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="A 定时陪伴" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Switch android:id="@+id/swA" android:contentDescription="A 定时陪伴开关" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:text="按下面时刻主动发一条陪伴消息。" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etSchedule" android:hint="逗号分隔，如 09:00,20:00" android:inputType="text" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <TextView android:text="B 久未互动" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Switch android:id="@+id/swB" android:contentDescription="B 久未互动开关" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:text="超过阈值小时没聊天，主动找你说话（防刷屏已内置）。" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etIdle" android:hint="超过几小时没聊就主动找话（默认 3）" android:inputType="numberDecimal" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- ========== 4. 云端语音 (MiMo TTS) ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="云端语音（MiMo TTS）" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="系统语音免费、无需 Key。想用更自然的「云端语音」才填这里——这是语音服务的 Key，和上面的 LLM Key 不是一回事，不能合并填一次。"
                android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:text="云端语音 API Key" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etTtsKey" android:hint="xiaomimimo 的 Key" android:inputType="textPassword" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:text="接口地址" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etTtsBase" android:hint="默认 https://api.xiaomimimo.com/v1" android:inputType="textUri" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:text="模型" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etTtsModel" android:hint="默认 mimo-v2.5-tts" android:inputType="text" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- ========== 5. 数据管理 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="数据管理（你的信息掌控）" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/tvDataInfo"
                android:text="你的全部数据都在 App 私有沙盒里（不联网、不进云）：\n• 聊天记录 / 网页聊天 Key / 云端语音 Key → LI 的网页存储（localStorage，键 liChatData_v2）\n• 推送 Key / 推送开关 / 阈值 / 时刻 → App 原生配置（shared_prefs）\n两套都在 /data/data/com.li.android/ 下，手机文件管理器翻不到（系统隔离），所以用本面板管理。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvStats"
                android:text="存储统计：打开一次 LI 后自动统计"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ========== 危险操作区 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_danger"
                android:padding="12dp"
                android:layout_marginTop="16dp">
                <TextView
                    android:text="⚠️ 危险操作区"
                    android:textColor="@color/danger"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="以下操作写入队列，返回主界面后由 LI 自动执行，且不可恢复。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <Button android:id="@+id/btnExport" android:text="导出聊天记录（写文件）" android:layout_marginTop="10dp" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnClearChat" android:text="清空聊天记录" android:layout_marginTop="8dp" android:backgroundTint="@color/danger" android:textColor="@android:color/white" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnResetAll" android:text="重置全部（清空 App + 网页）" android:layout_marginTop="8dp" android:backgroundTint="@color/danger" android:textColor="@android:color/white" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ========== 6. 状态 / 权限 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="状态 / 权限" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <TextView android:id="@+id/tvNotif" android:text="通知权限：检测中…" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnOpenNotif" android:text="去开启" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <TextView android:id="@+id/tvBattery" android:text="电池豁免：检测中…" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnOpenBattery" android:text="去开启" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <Button android:id="@+id/btnTestPush" android:text="发一条测试推送" android:layout_marginTop="8dp" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- ========== 7. 关于 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="关于" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvAppVersion" android:text="本机应用版本：…" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvLiVersion" android:text="内置 LI 内核版本：…" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- 固定底栏：保存 + 刷新 常驻可见 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="12dp"
        android:elevation="6dp">
        <Button
            android:id="@+id/btnRefresh"
            android:text="刷新"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/text_primary"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btnSave"
            android:text="保存"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand"
            android:textColor="@android:color/white"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
