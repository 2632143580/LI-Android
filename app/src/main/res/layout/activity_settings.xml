<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部应用栏 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ========== 1. 主动推送总开关 ========== -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="主动推送（总开关）"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />
                <Switch
                    android:id="@+id/swEnabled"
                    android:contentDescription="主动推送总开关"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView
                android:text="关闭后 App 不再后台主动找你；前台聊天照常。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ========== 2. 推送说话内容（App 只插入这句话；回复由 LI 网页模型生成） ========== -->
            <TextView
                android:text="推送说话内容"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:text="到点后，App 把这句话插入聊天（聊天里可见），LI 用【网页里配置的模型】回复你，App 再把 LI 的回复弹成通知。模型与 Key 在 LI 网页右上角设置里配——App 不存、也不调用任何单独的模型。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/etSayText"
                android:hint="默认：在吗？今天过得怎么样，说说话吧"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ========== 3. 推送行为 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="推送行为" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- 推送就绪状态（是否生效 + 原因） -->
            <TextView
                android:id="@+id/tvPushStatus"
                android:text="推送就绪状态：计算中…"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/btnTestSay"
                android:text="测试推送：让 li 说一句话"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/surface_variant"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <TextView android:text="A 定时陪伴" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Switch android:id="@+id/swA" android:contentDescription="A 定时陪伴开关" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:text="在设定时刻附近发一条陪伴消息（±7 分钟窗口；同一时刻每天最多一次）。" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etSchedule" android:hint="逗号分隔，如 09:00,20:00" android:inputType="text" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <TextView android:text="B 久未互动" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Switch android:id="@+id/swB" android:contentDescription="B 久未互动开关" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:text="超过阈值小时没聊天，主动找你说话。防刷屏已内置：每次主动找话后，须再间隔同样阈值小时才会再次打扰。"
                android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etIdle" android:hint="超过几小时没聊就主动找话（默认 3）" android:inputType="numberDecimal" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- ========== 4. 推送机制透明化说明 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="推送机制（全透明）" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView
                android:text="【谁在推送】App 自己，没有服务器。App 内置定时任务（WorkManager）每 15 分钟自问一次：该主动说话了吗？\n\n【怎么推送（完整流程）】\n每 15 分钟定时唤醒\n  ↓\nA 到点了？ / B 超时没聊了？（对应开关开启才判断）\n  ↓\n满足 → App 把「推送说话内容」插入聊天（聊天里可见）\n  ↓\nLI 用【网页里配置的模型】正常回复（和你在网页里聊天完全一样）\n  ↓\nApp 把 LI 的回复弹成通知 → 记录时间（防刷屏）\n\n【触发条件】\n• A 定时：在设定时刻 ±7 分钟内，且当天该时刻还没发过\n• B 久未互动：超过阈值小时没聊天，且距上次主动推送也超过阈值小时\n\n【模型在哪配】\nLI 网页右上角设置 → 聊天模型。网页里填的 Key/地址/模型就是推送用的模型——App 不存任何模型配置，所以模型改不了时请去网页设置。\n\n【生效前提】\n① 总开关开启 ② A 或 B 任一开启 ③ 网页已配置聊天模型（Key 非空）④ 通知权限已授权 ⑤ App 进程存活（被系统杀掉则无法推送，这是无服务器方案的固有边界）"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ========== 5. 云端语音 (MiMo TTS) ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="云端语音（MiMo TTS）" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="系统语音免费、无需 Key。想用更自然的「云端语音」才填这里——这是语音服务的 Key，和上面的 LLM Key 不是一回事。填完保存后返回主界面即生效；未填的地址/模型不会覆盖你在网页里已有的配置。"
                android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:text="云端语音 API Key（点右侧「显示」可查看明文）" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText android:id="@+id/etTtsKey" android:hint="xiaomimimo 的 Key" android:inputType="textPassword" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnToggleTtsKey" android:text="显示" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView android:text="接口地址（baseUrl，完整显示；留空=用网页已有配置）" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etTtsBase" android:hint="完整地址如 https://api.xiaomimimo.com/v1（留空不覆盖）" android:inputType="textUri" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <TextView android:text="模型（留空=用网页已有配置）" android:textSize="15sp" android:textColor="@color/text_primary" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/etTtsModel" android:hint="如 mimo-v2.5-tts（留空不覆盖）" android:inputType="text" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- ========== 6. 数据管理 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="数据管理（你的信息掌控）" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/tvDataInfo"
                android:text="你的全部数据都在 App 私有沙盒里（不联网、不进云）：\n• 聊天记录 / 网页聊天 Key（含推送用的模型）/ 云端语音 Key → LI 的网页存储（localStorage，键 liChatData_v2）\n• 推送开关 / 说话内容 / 阈值 / 时刻 → App 原生配置（shared_prefs）\n两套都在 /data/data/com.li.android/ 下，手机文件管理器翻不到（系统隔离），所以用本面板管理。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 统计（主界面设置按钮旁的「刷新」才是刷新 LI 网页；此处自动显示，无需按钮） -->
            <TextView
                android:id="@+id/tvStats"
                android:text="存储统计：打开一次 LI 后自动统计"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 导出（普通操作，不属于危险区） -->
            <Button
                android:id="@+id/btnExport"
                android:text="导出聊天记录（写文件，PC 可通过 USB 取）"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/surface_variant"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ========== 危险操作区（默认折叠） ========== -->
            <Button
                android:id="@+id/btnToggleDanger"
                android:text="展开危险操作区 ▾（清空 / 重置，不可恢复）"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/danger"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:id="@+id/dangerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_danger"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">
                <TextView
                    android:text="⚠️ 危险操作区（已展开）"
                    android:textColor="@color/danger"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="以下操作写入队列，返回主界面后由 LI 自动执行，且不可恢复。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <Button android:id="@+id/btnClearChat" android:text="清空聊天记录" android:layout_marginTop="10dp" android:backgroundTint="@color/danger" android:textColor="@android:color/white" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnResetAll" android:text="重置全部（清空 App + 网页）" android:layout_marginTop="8dp" android:backgroundTint="@color/danger" android:textColor="@android:color/white" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ========== 7. 状态 / 权限 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="状态 / 权限" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <TextView android:id="@+id/tvNotif" android:text="通知权限：检测中…" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnOpenNotif" android:text="去开启" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <TextView android:id="@+id/tvBattery" android:text="电池豁免：检测中…" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnOpenBattery" android:text="去开启" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <Button android:id="@+id/btnTestPush" android:text="发一条测试推送" android:layout_marginTop="8dp" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- ========== 8. 关于 ========== -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" />
            <TextView android:text="关于" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvAppVersion" android:text="本机应用版本：…" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvLiVersion" android:text="网页内核版本：…" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvUpdateStatus" android:text="更新状态：启动后自动检查" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnCheckUpdate" android:text="检查网页更新" android:layout_marginTop="8dp" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- 固定底栏：保存（刷新已移到自己对应的统计区旁） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="12dp"
        android:elevation="6dp">
        <Button
            android:id="@+id/btnSave"
            android:text="保存"
            android:layout_width="match_parent"
            android:backgroundTint="@color/brand"
            android:textColor="@android:color/white"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
